# ─── ChromaDB ────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=medical_products

# ─── API ─────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
